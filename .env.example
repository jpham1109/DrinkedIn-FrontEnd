# Copy to .env for local development.
#
# CRA bakes every REACT_APP_* variable into the compiled JS bundle at
# BUILD time, not read at runtime — on Render this means
# REACT_APP_BACKEND_URL must be set before the Static Site's build
# command runs, not just present at request time. Changing it later
# requires a rebuild/redeploy, not just an env var update.

# The Rails API's base URL, no trailing slash. Local dev: the backend's
# docker-compose port. Render: the deployed backend Web Service's exact
# URL, e.g. https://kinpour-api.onrender.com (or https://api.kinpour.com
# once that custom domain is live) — deploy the backend first if you
# don't have this yet.
REACT_APP_BACKEND_URL=http://localhost:3010

# Local dev server port only — unused by the production build.
PORT=3030
